<section class="page-hero page-hero--mojito">
  <div class="container">
    <h1 class="page-hero__title">{{ article.title }}</h1>
    <p class="page-hero__lede">{{ article.published_at | date: '%B %-d, %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
  </div>
</section>

<section class="section" style="background: var(--brand-paper);">
  <div class="container" style="max-width: 820px;">
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" style="width: 100%; height: auto; border-radius: var(--radius-card); margin-bottom: 32px;" />
    {%- endif -%}
    <div style="font-size: 17px; line-height: 1.7;">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div style="margin-top: 48px;">
        {%- if article.comments_count > 0 -%}
          <h2 class="section__title" style="font-size: 32px; margin-bottom: 24px;">{{ article.comments_count }} comment{{ article.comments_count | pluralize: '', 's' }}</h2>
          {%- for comment in article.comments -%}
            <div style="background: var(--brand-cream); border-radius: 18px; padding: 20px; margin-bottom: 14px;">
              <p>{{ comment.content }}</p>
              <p style="font-weight: 700; font-size: 14px;">— {{ comment.author }}</p>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div style="margin-top: 40px;">
      <a href="{{ blog.url }}" class="btn btn--alt">← Back to {{ blog.title }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Article",
  "settings": [],
  "presets": [{ "name": "Article" }]
}
{% endschema %}
