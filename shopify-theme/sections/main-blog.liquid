<section class="page-hero page-hero--mojito">
  <div class="container">
    <h1 class="page-hero__title">{{ blog.title }}</h1>
  </div>
</section>

<section class="section" style="background: var(--brand-paper);">
  <div class="container">
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="flavors__grid">
          {%- for article in blog.articles -%}
            <article class="flavor-card reveal" style="background: var(--brand-cream);">
              {%- if article.image -%}
                <div class="flavor-card__can" style="height: 200px;">
                  <a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" style="border-radius: 18px; object-fit: cover; height: 100%;" /></a>
                </div>
              {%- endif -%}
              <h3 class="flavor-card__name" style="font-size: 24px;"><a href="{{ article.url }}" style="color: inherit;">{{ article.title }}</a></h3>
              <p class="flavor-card__desc">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              <a href="{{ article.url }}" class="flavor-card__cta">Read more →</a>
            </article>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div style="text-align: center; margin-top: 48px;">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- else -%}
        <p style="text-align: center; padding: 60px 0;">No posts yet. Check back soon.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
