<section class="page-hero page-hero--watermelon">
  <div class="container">
    <h1 class="page-hero__title">Collections</h1>
  </div>
</section>

<section class="section" style="background: var(--brand-paper);">
  <div class="container">
    <div class="flavors__grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="flavor-card reveal" style="background: var(--brand-cream); text-decoration: none;">
          <div class="flavor-card__can" style="height: 220px;">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}" width="600" height="{{ 600 | divided_by: collection.featured_image.aspect_ratio | round }}" alt="{{ collection.title | escape }}" loading="lazy" />
            {%- endif -%}
          </div>
          <h3 class="flavor-card__name" style="font-size: 26px;">{{ collection.title }}</h3>
          <p class="flavor-card__desc">{{ collection.products_count }} product{{ collection.products_count | pluralize: '', 's' }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List collections",
  "settings": [],
  "presets": [{ "name": "List collections" }]
}
{% endschema %}
