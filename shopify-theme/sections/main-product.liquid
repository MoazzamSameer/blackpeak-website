<section class="section" style="background: var(--brand-paper);">
  <div class="container">
    <div class="product-page__grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;">
      <div>
        {%- if product.featured_image != blank -%}
          <img src="{{ product.featured_image | image_url: width: 800 }}" width="800" height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}" alt="{{ product.featured_image.alt | default: product.title }}" style="max-width: 100%; height: auto; filter: drop-shadow(0 30px 60px rgba(23, 58, 35, 0.4));" />
        {%- endif -%}
      </div>
      <div>
        <h1 class="section__title" style="font-size: clamp(40px, 6vw, 64px); margin-bottom: 16px;">{{ product.title }}</h1>
        <p style="font-family: var(--font-display); font-weight: 700; font-size: 28px; margin-bottom: 24px;">{{ product.price | money }}</p>
        <div style="font-size: 17px; line-height: 1.6; margin-bottom: 28px;">{{ product.description }}</div>
        {%- form 'product', product, id: 'productForm', class: 'product-form' -%}
          {%- if product.variants.size > 1 -%}
            <div style="margin-bottom: 20px;">
              <label for="variant-select" style="display: block; font-weight: 700; margin-bottom: 8px;">Variant</label>
              <select name="id" id="variant-select" style="padding: 12px 16px; border-radius: 10px; border: 2px solid var(--brand-ink); font: inherit; background: #fff;">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}"{% if variant.available == false %} disabled{% endif %}{% if variant == product.selected_or_first_available_variant %} selected{% endif %}>
                    {{ variant.title }} — {{ variant.price | money }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
          {%- endif -%}
          <button type="submit" class="btn"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 980px) {
    .product-page__grid { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Product page",
  "settings": [],
  "presets": [
    { "name": "Product page" }
  ]
}
{% endschema %}
