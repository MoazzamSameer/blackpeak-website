<section class="page-hero page-hero--apple">
  <div class="container">
    <h1 class="page-hero__title">{{ page.title }}</h1>
  </div>
</section>

<section class="section" style="background: var(--brand-paper);">
  <div class="container" style="max-width: 820px;">
    <div style="font-size: 17px; line-height: 1.7; color: var(--brand-ink);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Page content", "settings": [] }
{% endschema %}
