{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#173A23" />
  <title>{{ shop.name }} Gift Card</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-gift-card">
  <section class="section" style="min-height: 100vh; display: flex; align-items: center; background: var(--brand-cream);">
    <div class="container" style="max-width: 520px; text-align: center;">
      <a class="nav__logo" style="display: inline-block; margin-bottom: 24px;">{{ shop.name | upcase }}</a>
      <h1 class="section__title" style="font-size: clamp(36px, 6vw, 56px); margin-bottom: 8px;">Your gift card</h1>
      <p style="color: var(--brand-ink-soft); margin-bottom: 24px;">Here's your {{ shop.name }} gift card.</p>

      <div style="background: var(--apple-bg); border-radius: var(--radius-card); padding: 36px; box-shadow: var(--shadow-card); margin-bottom: 24px;">
        <div style="font-family: var(--font-display); font-weight: 700; font-size: clamp(48px, 9vw, 72px); line-height: 1; color: var(--apple-deep);">
          {%- if gift_card.balance != gift_card.initial_value -%}
            {{ gift_card.balance | money }}
            <div style="font-size: 16px; font-weight: 600;">left of {{ gift_card.initial_value | money }}</div>
          {%- else -%}
            {{ gift_card.balance | money }}
          {%- endif -%}
        </div>
      </div>

      <div style="background: #fff; border-radius: var(--radius-card); padding: 24px 28px; box-shadow: var(--shadow-card); display: inline-block; margin-bottom: 24px;">
        <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand-ink-soft); margin-bottom: 8px;">Gift card code</div>
        <div style="font-family: var(--font-display); font-weight: 700; font-size: 26px; letter-spacing: 0.06em;">{{ gift_card.code | format_code }}</div>
      </div>

      {%- if gift_card.expired and gift_card.enabled -%}
        <p style="color: var(--watermelon-deep); font-weight: 700;">Expired on {{ gift_card.expires_on | date: '%B %-d, %Y' }}</p>
      {%- elsif gift_card.expires_on and gift_card.enabled -%}
        <p style="color: var(--brand-ink-soft); font-size: 14px;">Expires {{ gift_card.expires_on | date: '%B %-d, %Y' }}</p>
      {%- elsif gift_card.enabled == false -%}
        <p style="color: var(--watermelon-deep); font-weight: 700;">This gift card is disabled.</p>
      {%- endif -%}

      <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="{{ shop.url }}" class="btn">Shop now →</a>
        <button class="btn btn--alt" onclick="window.print();">Print</button>
      </div>
    </div>
  </section>
</body>
</html>
